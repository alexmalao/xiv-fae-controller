<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Fae Nightwolf</Author>
    <Name>Fae Nightwolf's Alteration Shop</Name>
    <Punchline>Clock spot coordination and controller-based clock spot targeting.</Punchline>
    <Description>Automatically seats your party into clock spot positions (with role priority and
encounter-specific layouts for FRU and TOP), lets you rearrange them by dragging slots, and
prompts the party with a clickable link when entering an instance. Numpad1-8 can be bound to a
controller to soft/hard target whoever is standing at a given clock position.</Description>
    <RepoUrl>https://github.com/alexmalao/xiv-fae-controller</RepoUrl>
    <Tags>party;targeting;utility</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Data\fae.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Data\fae.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Data\kaiten.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Data\HagakureAnimation\abl006.tmb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Data\HagakureAnimation\abl006.pap">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
